<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
 <xs:simpleType name="nonEmpty"><xs:restriction base="xs:string"><xs:minLength value="1"/></xs:restriction></xs:simpleType>
 <xs:element name="catalog"><xs:complexType><xs:sequence>
  <xs:element name="news" minOccurs="15" maxOccurs="20"><xs:complexType><xs:sequence>
   <xs:element name="title" type="nonEmpty"/><xs:element name="date" type="xs:date"/>
   <xs:element name="category"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="Основы"/><xs:enumeration value="Тембр"/><xs:enumeration value="Динамика"/><xs:enumeration value="Пространство"/><xs:enumeration value="Стерео"/><xs:enumeration value="Проверка"/></xs:restriction></xs:simpleType></xs:element>
   <xs:element name="level"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="Начальный"/><xs:enumeration value="Средний"/><xs:enumeration value="Продвинутый"/></xs:restriction></xs:simpleType></xs:element>
   <xs:element name="minutes"><xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="60"/></xs:restriction></xs:simpleType></xs:element>
   <xs:element name="summary" type="nonEmpty"/>
   <xs:element name="link"><xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="(services/)?[a-z]+[.]html"/></xs:restriction></xs:simpleType></xs:element>
  </xs:sequence><xs:attribute name="id" type="xs:ID" use="required"/></xs:complexType></xs:element>
 </xs:sequence></xs:complexType></xs:element>
</xs:schema>
