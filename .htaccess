Options -Indexes
<FilesMatch "\.(sqlite|db|sql)$">
Require all denied
</FilesMatch>

# Keep the shared XML menu URL while executing PHP on Apache hosts.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^rss\.html$ rss.php [L]
RewriteRule ^database\.html$ database.php [L]
RewriteRule ^xml\.html$ xml.php [L]
RewriteRule ^services/news\.html$ services/news.php [L]
</IfModule>

# Revalidate HTML so returning visitors see updated links and resource versions.
<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
